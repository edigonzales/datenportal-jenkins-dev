<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jenkins-ci.plugins</groupId>
        <artifactId>plugin</artifactId>
        <version>6.2189.v695a_c41f5249</version>
        <relativePath />
    </parent>

    <groupId>ch.so.agi.jenkins</groupId>
    <artifactId>jenkins-gretl-datenportal-plugin</artifactId>
    <version>${revision}</version>
    <packaging>hpi</packaging>

    <name>GRETL Datenportal Jobs</name>
    <description>Jenkins plugin for GRETL Datenportal job catalogues, forms, and generated pipeline jobs.</description>
    <url>https://github.com/sogis/jenkins-gretl-datenportal-plugin</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>sogis</id>
            <name>Amt fuer Geoinformation Kanton Solothurn</name>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/sogis/jenkins-gretl-datenportal-plugin.git</connection>
        <developerConnection>scm:git:https://github.com/sogis/jenkins-gretl-datenportal-plugin.git</developerConnection>
        <url>https://github.com/sogis/jenkins-gretl-datenportal-plugin</url>
        <tag>${scmTag}</tag>
    </scm>

    <repositories>
        <repository>
            <id>repo.jenkins-ci.org</id>
            <url>https://repo.jenkins-ci.org/releases/</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>repo.jenkins-ci.org</id>
            <url>https://repo.jenkins-ci.org/releases/</url>
        </pluginRepository>
    </pluginRepositories>

    <properties>
        <revision>0.1.0-SNAPSHOT</revision>
        <changelist />
        <scmTag>HEAD</scmTag>
        <jenkins.version>2.555.2</jenkins.version>
        <hpi.compatibleSinceVersion>0.1.0</hpi.compatibleSinceVersion>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.jenkins.tools.bom</groupId>
                <artifactId>bom-2.555.x</artifactId>
                <version>6453.v115ff6f496dd</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.jenkins.plugins</groupId>
            <artifactId>snakeyaml-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jenkins-ci.plugins.workflow</groupId>
            <artifactId>workflow-job</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jenkins-ci.plugins.workflow</groupId>
            <artifactId>workflow-cps</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jenkins.plugins</groupId>
            <artifactId>file-parameters</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jenkins-ci.plugins</groupId>
            <artifactId>email-ext</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
